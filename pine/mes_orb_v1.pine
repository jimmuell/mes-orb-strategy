//@version=6
strategy("MES ORB Strategy v1", overlay=true, default_qty_type=strategy.fixed, default_qty_value=2, initial_capital=10000, commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=1, calc_on_every_tick=false)

// ─── Inputs ───────────────────────────────────────────────────────────────────
i_retestTicks   = input.int(4, "Retest Tolerance (ticks)", minval=1, maxval=20)
i_emaLen        = input.int(9, "EMA Length", minval=1)
i_rrRatio       = input.float(2.0, "Reward:Risk Ratio", minval=0.5, step=0.5)

// ─── Constants ────────────────────────────────────────────────────────────────
TICK_SIZE = syminfo.mintick  // 0.25 for MES

// ─── Session Detection ────────────────────────────────────────────────────────
isORBBar      = not na(time("5", "0930-0935:23456", "America/Chicago"))
isSessionBar  = not na(time("5", "0930-1600:23456", "America/Chicago"))
isNewSession  = isSessionBar and not isSessionBar[1]

// ─── Manual VWAP ──────────────────────────────────────────────────────────────
var float cumTPV = 0.0
var float cumVol = 0.0
var float vwapVal = na

if isNewSession
    cumTPV := 0.0
    cumVol := 0.0

if isSessionBar
    cumTPV += hlc3 * volume
    cumVol += volume
    vwapVal := cumVol != 0 ? cumTPV / cumVol : na

plot(vwapVal, "VWAP", color=color.orange, linewidth=2)

// ─── EMA-9 ────────────────────────────────────────────────────────────────────
ema9 = ta.ema(close, i_emaLen)
plot(ema9, "EMA 9", color=color.blue)

// ─── ORB Tracking ─────────────────────────────────────────────────────────────
var float orbHigh = na
var float orbLow  = na
var bool  orbSet  = false

if isNewSession
    orbHigh := na
    orbLow  := na
    orbSet  := false

if isORBBar
    if na(orbHigh)
        orbHigh := high
        orbLow  := low
    else
        orbHigh := math.max(orbHigh, high)
        orbLow  := math.min(orbLow, low)
    orbSet := true

plot(orbSet ? orbHigh : na, "ORB High", color=color.green, style=plot.style_linebr, linewidth=1)
plot(orbSet ? orbLow  : na, "ORB Low",  color=color.red,   style=plot.style_linebr, linewidth=1)

// ─── Trade State ──────────────────────────────────────────────────────────────
var bool tradedToday    = false
var bool brokeAbove     = false
var bool brokeBelow     = false

if isNewSession
    tradedToday := false
    brokeAbove  := false
    brokeBelow  := false

// ─── Breakout Detection (post-ORB only) ───────────────────────────────────────
postORB = orbSet and not isORBBar and isSessionBar

if postORB and not na(orbHigh)
    if close > orbHigh
        brokeAbove := true
    if close < orbLow
        brokeBelow := true

// ─── Retest + Confluence Logic ────────────────────────────────────────────────
retestTol = i_retestTicks * TICK_SIZE

// Long: broke above, now price retests ORB high from above, VWAP & EMA confirm
longRetest = brokeAbove and not tradedToday and postORB
             and low <= orbHigh + retestTol
             and close > orbHigh
             and close > vwapVal
             and close > ema9

// Short: broke below, now price retests ORB low from below, VWAP & EMA confirm
shortRetest = brokeBelow and not tradedToday and postORB
              and high >= orbLow - retestTol
              and close < orbLow
              and close < vwapVal
              and close < ema9

// ─── Order Execution ──────────────────────────────────────────────────────────
float longStop  = na
float longTP    = na
float shortStop = na
float shortTP   = na

if longRetest and strategy.position_size == 0
    longStop  := orbLow
    longTP    := close + i_rrRatio * (close - orbLow)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", "Long", stop=longStop, limit=longTP)
    tradedToday := true

if shortRetest and strategy.position_size == 0
    shortStop := orbHigh
    shortTP   := close - i_rrRatio * (orbHigh - close)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", "Short", stop=shortStop, limit=shortTP)
    tradedToday := true

// ─── End-of-Session Flatten ───────────────────────────────────────────────────
isSessionEnd = not na(time("5", "1555-1600:23456", "America/Chicago"))

if isSessionEnd and strategy.position_size != 0
    strategy.close_all("Session Close")

// ─── Debug Labels ─────────────────────────────────────────────────────────────
if longRetest and strategy.position_size == 0
    label.new(bar_index, low, "L", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if shortRetest and strategy.position_size == 0
    label.new(bar_index, high, "S", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
